NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Optional alias (newer Supabase docs name):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Auth: set Site URL + Redirect URLs in Supabase Dashboard → Authentication → URL Configuration
# Site URL: https://talktgtla.com
# Redirect allow list: https://talktgtla.com/** , https://talktgtla.com/auth/confirm , https://talktgtla.com/auth/callback , http://localhost:3000/**

# Auth Google OAuth: enable in Supabase Dashboard → Authentication → Providers → Google.
# Create a Google Cloud OAuth Web client; authorized redirect URI:
#   https://etbgulbuzezrdoqvvamy.supabase.co/auth/v1/callback
# Put Client ID + Client Secret ONLY in the Supabase dashboard — never in Next.js env / this file.
# Site URL must be https://talktgtla.com (see Auth URL Configuration above).
NEXT_PUBLIC_SITE_URL=https://talktgtla.com

# Server-only admin moderation (never commit real values)
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_DELETE_TOKEN=long-random-token-matching-private.admin_config
ADMIN_SESSION_SECRET=long-random-hmac-secret
CRON_SECRET=

# Meal vision (Vercel AI Gateway). On Vercel, OIDC auth is automatic.
# Local: vercel link && vercel env pull, or set AI_GATEWAY_API_KEY.
AI_GATEWAY_MODEL=google/gemini-2.5-flash
# AI_GATEWAY_API_KEY=
# Free AI meal estimates per person per HK day (default 3)
EAT_AI_FREE_DAILY_LIMIT=3

